<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Painel de Manutenção — Taxa de Quebra</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --azul: #1f5aa6;
      --laranja: #c85a17;
      --cinza: #4a5568;
      --fundo: #ffffff;
      --cartao: #f7f9fc;
      --borda: #e2e8f0;
      --texto: #1a202c;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #f1f5f9;
      color: var(--texto);
      padding: 24px;
      line-height: 1.45;
    }

    .painel {
      max-width: 1180px;
      margin: 0 auto;
      background: var(--fundo);
      border: 1px solid var(--borda);
      border-radius: 12px;
      padding: 28px 32px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    }

    header h1 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 20px;
      color: var(--texto);
    }

    .kpis {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 28px;
    }

    .kpi {
      background: var(--cartao);
      border: 1px solid var(--borda);
      border-radius: 10px;
      padding: 16px 20px;
    }

    .kpi-titulo {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--cinza);
      margin-bottom: 6px;
    }

    .kpi-valor {
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 4px;
    }

    .kpi-detalhe {
      font-size: 0.88rem;
      color: var(--cinza);
    }

    .cor-cinza { color: var(--cinza); }
    .cor-azul { color: var(--azul); }
    .cor-laranja { color: var(--laranja); }

    .graficos {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 24px;
      margin-bottom: 24px;
    }

    .caixa-grafico {
      background: var(--fundo);
      border: 1px solid var(--borda);
      border-radius: 10px;
      padding: 18px;
    }

    .caixa-grafico h2 {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 12px;
      color: var(--texto);
    }

    .canvas-wrap {
      position: relative;
      height: 320px;
    }

    footer {
      border-top: 1px solid var(--borda);
      padding-top: 16px;
      font-size: 0.96rem;
      color: var(--texto);
    }

    @media (max-width: 860px) {
      .kpis, .graficos { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <main class="painel" aria-label="Painel de manutenção preventiva">
    <header>
      <h1 id="titulo"></h1>
    </header>

    <section class="kpis" aria-label="Indicadores principais">
      <article class="kpi">
        <div class="kpi-titulo">Quebra geral</div>
        <div class="kpi-valor cor-cinza" id="kpi-geral-valor"></div>
        <div class="kpi-detalhe" id="kpi-geral-detalhe"></div>
      </article>
      <article class="kpi">
        <div class="kpi-titulo">Antes de 200 min</div>
        <div class="kpi-valor cor-azul" id="kpi-antes-valor"></div>
        <div class="kpi-detalhe" id="kpi-antes-detalhe"></div>
      </article>
      <article class="kpi">
        <div class="kpi-titulo">A partir de 200 min</div>
        <div class="kpi-valor cor-laranja" id="kpi-partir-valor"></div>
        <div class="kpi-detalhe" id="kpi-partir-detalhe"></div>
      </article>
    </section>

    <section class="graficos">
      <div class="caixa-grafico">
        <h2>Taxa de quebra por faixa de uso (%), com IC 95%</h2>
        <div class="canvas-wrap">
          <canvas id="grafico-principal"></canvas>
        </div>
      </div>

      <div class="caixa-grafico">
        <h2>Modos entre as quebras (% no grupo)</h2>
        <div class="canvas-wrap">
          <canvas id="grafico-apoio"></canvas>
        </div>
      </div>
    </section>

    <footer id="frase"></footer>
  </main>

  <script>
    // =========================================================================
    // EDITE AQUI com os números exatos da Fácil 1, Fácil 2 e Fácil 3 do Colab
    // =========================================================================
    const DADOS = {
      titulo: "Taxa de quebra e tempo de uso da ferramenta — 10.000 peças",
      frase:
        "A taxa de quebra sobe de 2,4% abaixo de 200 min para 13,8% a partir de 200 min, com maior concentração de falhas ligadas ao desgaste e sobrecarga. O corte de 200 min apenas descreve e compara estes registros, não servindo como limiar validado de manutenção.",
      kpis: {
        geral:  { taxa: "3,4%",  detalhe: "339 quebras em 10.000 peças na base inteira" },
        antes:  { taxa: "2,4%",  detalhe: "221 quebras em 9.144 peças abaixo de 200 min" },
        partir: { taxa: "13,8%", detalhe: "118 quebras em 856 peças a partir de 200 min" }
      },
      faixas: {
        rotulos: ["0–49", "50–99", "100–149", "150–199", "200+"],
        taxas:   [2.2, 2.3, 2.5, 2.7, 13.8],
        icMin:   [1.7, 1.8, 1.9, 2.1, 11.6],
        icMax:   [2.9, 3.0, 3.2, 3.5, 16.3]
      },
      modos: {
        rotulos: ["TWF", "HDF", "PWF", "OSF", "RNF"],
        antes:   [0.0, 48.0, 36.0, 14.0, 0.5],
        partir:  [39.0, 8.0, 12.0, 56.0, 0.0]
      }
    };

    // Preenche textos e KPIs
    document.getElementById("titulo").textContent = DADOS.titulo;
    document.getElementById("frase").textContent = DADOS.frase;
    document.getElementById("kpi-geral-valor").textContent = DADOS.kpis.geral.taxa;
    document.getElementById("kpi-geral-detalhe").textContent = DADOS.kpis.geral.detalhe;
    document.getElementById("kpi-antes-valor").textContent = DADOS.kpis.antes.taxa;
    document.getElementById("kpi-antes-detalhe").textContent = DADOS.kpis.antes.detalhe;
    document.getElementById("kpi-partir-valor").textContent = DADOS.kpis.partir.taxa;
    document.getElementById("kpi-partir-detalhe").textContent = DADOS.kpis.partir.detalhe;

    const AZUL = "#1f5aa6";
    const LARANJA = "#c85a17";

    // Plugin simples para desenhar as barras de erro (IC 95%) no gráfico principal
    const pluginIC = {
      id: "barrasIC",
      afterDatasetsDraw(chart) {
        const { ctx, scales: { x, y } } = chart;
        ctx.save();
        ctx.lineWidth = 2.5;
        DADOS.faixas.rotulos.forEach((_, i) => {
          const xPos = x.getPixelForValue(i);
          const yMin = y.getPixelForValue(DADOS.faixas.icMin[i]);
          const yMax = y.getPixelForValue(DADOS.faixas.icMax[i]);
          ctx.strokeStyle = i === DADOS.faixas.rotulos.length - 1 ? LARANJA : AZUL;
          ctx.beginPath();
          ctx.moveTo(xPos, yMin);
          ctx.lineTo(xPos, yMax);
          ctx.moveTo(xPos - 6, yMin);
          ctx.lineTo(xPos + 6, yMin);
          ctx.moveTo(xPos - 6, yMax);
          ctx.lineTo(xPos + 6, yMax);
          ctx.stroke();
        });
        ctx.restore();
      }
    };

    // 1. Gráfico principal
    new Chart(document.getElementById("grafico-principal"), {
      type: "bar",
      data: {
        labels: DADOS.faixas.rotulos,
        datasets: [{
          label: "Taxa de quebra (%)",
          data: DADOS.faixas.taxas,
          backgroundColor: DADOS.faixas.rotulos.map((_, i) =>
            i === DADOS.faixas.rotulos.length - 1 ? LARANJA : AZUL
          ),
          borderRadius: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: (ctx) => {
                const i = ctx.dataIndex;
                return `Taxa: ${DADOS.faixas.taxas[i]}% (IC 95%: ${DADOS.faixas.icMin[i]}% a ${DADOS.faixas.icMax[i]}%)`;
              }
            }
          }
        },
        scales: {
          x: { title: { display: true, text: "Tempo de uso da ferramenta (min)" } },
          y: {
            beginAtZero: true,
            suggestedMax: Math.ceil(Math.max(...DADOS.faixas.icMax) + 2),
            title: { display: true, text: "Taxa de quebra (%)" }
          }
        }
      },
      plugins: [pluginIC]
    });

    // 2. Gráfico de apoio
    new Chart(document.getElementById("grafico-apoio"), {
      type: "bar",
      data: {
        labels: DADOS.modos.rotulos,
        datasets: [
          { label: "< 200 min", data: DADOS.modos.antes, backgroundColor: AZUL, borderRadius: 4 },
          { label: ">= 200 min", data: DADOS.modos.partir, backgroundColor: LARANJA, borderRadius: 4 }
        ]
      },
      options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: "bottom" }
        },
        scales: {
          x: {
            beginAtZero: true,
            title: { display: true, text: "% das quebras no grupo" }
          }
        }
      }
    });
  </script>
</body>
</html>
